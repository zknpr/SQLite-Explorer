# Exclude everything by default
**/*

# Include compiled extension
!out/
!out/**

# Include core UI and utilities
!core/
!core/**

# Include WASM binary
!assets/
!assets/**

# Include native binaries
!natives/
!natives/**

# Include localization
!l10n/
!l10n/**

# Include icon
!media/icon.png

# Include codicons for UI (@vscode/codicons package)
# node_modules is NOT shipped: esbuild bundles the extension's runtime deps into
# out/, and the only asset we need from a package — the codicon font+css — is
# copied to assets/codicons/ by build.mjs (2 files, ~160KB) and served from
# there. Shipping node_modules/@vscode/codicons instead dragged in 4.6MB / 598
# files (2.3MB src/ SVGs, a 1.2MB preview HTML, ...) — vsce's ignore engine
# re-includes the whole subtree from any dir-level negation, so it's excluded
# wholesale here and the runtime files live under assets/ instead.

# Include documentation
!CHANGELOG.md
!LICENSE.md
!README.md

# Include package manifest and translations
!package.json
!package.nls.*

# Exclude source files (not needed in published extension)
src/
scripts/
tsconfig.json
CLAUDE.md

# Exclude development files
.git/
.gitignore
.tmp/
*.local
*.log

# Exclude test files
exampleFiles/
mySolidTest/
tests/desktop/
.desktop-test-out/
.vscode-test/
tsconfig.desktop.json
*.test.ts
*.spec.ts
